[Unit]
Description=Lutopia 唤醒桥
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lutopia-wake
Group=lutopia-wake
WorkingDirectory=/opt/lutopia-wake-bridge
EnvironmentFile=/etc/lutopia-wake.env
ExecStart=/usr/bin/node /opt/lutopia-wake-bridge/dist/cli.js run
Restart=no
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
